# Conductivity website settings. Copy the names into Vercel → Project → Settings → Environment Variables.
# For local testing, copy this file to .env.local (never commit .env.local).
# Every setting is optional: the site works without them, and each feature switches on when its setting is added.

# --- Site ---------------------------------------------------------------------
# Live address, used for canonical links, the sitemap and social previews (§14).
NEXT_PUBLIC_SITE_URL=https://www.conductivity.com.pk

# --- Analytics (§17) -------------------------------------------------------------
# Google Analytics 4 measurement ID. Adding it shows the cookie consent banner; analytics runs only after "Accept".
NEXT_PUBLIC_GA_ID=

# --- CRM (§13) -------------------------------------------------------------------
# Webhook that receives every form submission (e.g. a Zapier or Make "Catch hook" connected to HubSpot or Zoho).
CRM_WEBHOOK_URL=

# Lead owner per team (name or email), written on each lead.
CRM_OWNER_EMPLOYER=
CRM_OWNER_TALENT=
CRM_OWNER_PARTNER=
CRM_OWNER_MARKETING=
CRM_OWNER_PRIVACY=

# --- Emails (§13.4) ---------------------------------------------------------------
# Resend (resend.com) API key: sends visitor confirmations and team alerts.
RESEND_API_KEY=
# Sender, from a domain verified in Resend.
NOTIFY_FROM=Conductivity <no-reply@conductivity.com.pk>
# Team inboxes for alerts. NOTIFY_DEFAULT is used for any team without its own address.
NOTIFY_DEFAULT=info@conductivity.com.pk
NOTIFY_EMPLOYER=
NOTIFY_TALENT=
NOTIFY_PARTNER=
NOTIFY_MARKETING=
NOTIFY_PRIVACY=
NOTIFY_LEARNING=

# --- CMS: Sanity (§18 criterion 5) -------------------------------------------------
# From sanity.io/manage → your project. Articles, opportunities and events then come from Sanity
# (changes appear on the site within about 5 minutes). Leave empty to use the local content files.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Look ------------------------------------------------------------------------
# Colour palette: "logo" (default, red and blue) or "navy".
NEXT_PUBLIC_PALETTE=logo
